CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_SYSMON is not set
# CONFIG_TV4_BOARD_REV12 is not set
# Flash geometry and PSRAM are selected only by the bench board profile.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Verified local backup is 16 MiB; image/layout target requested for this board.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
